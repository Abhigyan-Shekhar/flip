# Copy to .env, chmod 600 .env, then generate a random API token locally.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SWITCHCREW_API_TOKEN=
SWITCHCREW_DATABASE_PATH=data/switchcrew.sqlite3
# Optional private JSON role -> Codex/Antigravity CLI mapping. Run local CLIs
# under a pre-authenticated operator account; no model API keys required.
SWITCHCREW_HARNESS_CONFIG=
# PM model planning budgets. Fallback is explicitly off unless enabled by operator.
SWITCHCREW_HARNESS_PLANNER_MAX_CALLS=2
SWITCHCREW_HARNESS_PLANNER_MAX_STEPS=12
SWITCHCREW_HARNESS_PLANNER_MAX_PROMPT_CHARS=24000
SWITCHCREW_HARNESS_PLANNER_FALLBACK=false
# Native signed slash-command webhook (operator-provisioned public key only).
SWITCHCREW_DISCORD_APPLICATION_PUBLIC_KEY=
# Agent bridge URL (not gateway/Console). Use HTTPS for remote hosts.
# Docker Desktop container -> host: https://your-secured-switch-agent-bridge
SWITCHCREW_SWITCH_BASE_URL=http://127.0.0.1:8080
SWITCHCREW_SWITCH_ROOM_ID=
# Registration output id values. Never interchange these with participant IDs.
SWITCHCREW_PM_AGENT_ID=
SWITCHCREW_RESEARCH_AGENT_ID=
SWITCHCREW_PM_API_KEY=
SWITCHCREW_RESEARCH_API_KEY=
# Verified opaque sender participant IDs from Switch room membership.
SWITCHCREW_PM_PARTICIPANT_ID=
SWITCHCREW_RESEARCH_PARTICIPANT_ID=
# Exact room participant names used by targeted messaging.
SWITCHCREW_PM_NAME="pm-agent"
SWITCHCREW_RESEARCH_NAME="research-agent"
# JSON arrays; empty allowlists refuse all human requests.
SWITCHCREW_DISCORD_GUILD_IDS=[]
SWITCHCREW_DISCORD_USER_IDS=[]
# Operator-verified mapping, e.g. [{"room_id":"...","bridge_id":"...",
# "guild_id":"...","channel_id":"...","participant_id":"...","user_id":"..."}]
SWITCHCREW_DISCORD_BINDINGS=[]
# Operator-verified Discord thread -> Switch root mapping; see OPERATOR_DASHBOARD.md.
SWITCHCREW_DISCORD_THREAD_BINDINGS=[]
# Public HTTPS text/HTML/Markdown/JSON pages used by extractive Research.
SWITCHCREW_RESEARCH_SOURCE_URLS=[]
SWITCHCREW_RESEARCH_MAX_SOURCES=5
# Optional read-only Company Brain context. Disabled by default; use an
# operator-provisioned registry whose root and revision exactly match these.
SWITCHCREW_COMPANY_BRAIN_ENABLED=false
SWITCHCREW_COMPANY_BRAIN_COMMAND=[]
# Alternatively configure an HTTPS MCP endpoint (never expose its token).
# SWITCHCREW_COMPANY_BRAIN_URL=https://your-company-brain/mcp
SWITCHCREW_COMPANY_BRAIN_TOKEN=
SWITCHCREW_COMPANY_BRAIN_REPO_ROOT=
SWITCHCREW_COMPANY_BRAIN_REVISION=
SWITCHCREW_COMPANY_BRAIN_MAX_RESULTS=5
# Separate durable state for each specialist's LangGraph nodes.
SWITCHCREW_CHECKPOINT_PATH=data/checkpoints.sqlite3
# Product memory is optional. Recall shares this project; observations retain role/task provenance.
SWITCHCREW_MEMORY_ENABLED=false
SWITCHCREW_MEMORY_PROJECT=github.com/Abhigyan-Shekhar/flip
# Choose one existing MCP server transport when memory is enabled.
SWITCHCREW_WAGGLE_COMMAND=[]
# SWITCHCREW_WAGGLE_COMMAND=["/path/to/waggle/.venv/bin/python","-m","waggle.entrypoints.server_only","--quiet"]
# SWITCHCREW_WAGGLE_URL=https://your-waggle-host/mcp
# SWITCHCREW_WAGGLE_TOKEN=configure-locally
# Generic specialists each use one protected registry file, never a shared all-key file.
# SWITCHCREW_AGENT_REGISTRY=/private/engineering.json

# Optional approved PM -> Engineering -> QA -> Release route.
# Public registration IDs and exact targeted machine names; all specialists differ.
SWITCHCREW_ENGINEERING_AGENT_ID=
SWITCHCREW_ENGINEERING_NAME=
SWITCHCREW_REVIEWER_AGENT_ID=
SWITCHCREW_MAX_CORRECTIONS=2
SWITCHCREW_QA_AGENT_ID=
SWITCHCREW_RELEASE_AGENT_ID=
SWITCHCREW_RELEASE_NAME=
# Publication destination is included in the durable request and release approval.
SWITCHCREW_RELEASE_REPOSITORY=
SWITCHCREW_RELEASE_BASE=
# Discord approvers also need a verified binding and normal ingress allowlists.
SWITCHCREW_APPROVAL_USER_IDS=[]
# API-only map: human identity -> independent random token (32+ chars).
# Never distribute these tokens to worker processes. Empty map refuses approval.
SWITCHCREW_APPROVAL_CREDENTIALS={}
# Participant/employee API credentials identify humans without granting release approval.
SWITCHCREW_HUMAN_CREDENTIALS={}
# Optional private JSON for meeting, knowledge, employee, security and OSS policies.
# Mount the same config read-only into API/PM/specialist processes when containerized.
SWITCHCREW_ORGANIZATION_CONFIG=
# GitHub token lives only in the private Release worker config; see docs/APPROVAL_RELEASE.md.

# Optional bounded PM decomposition and read-only specialist dispatch.
# JSON role -> public registration ID and exact Switch target name.
# Example: {"documentation":{"agent_id":"...","name":"documentation-agent"}}
SWITCHCREW_SPECIALIST_TARGETS={}
# Only an operator-owned template can authorize the job selection for planned Engineering.
# Every Engineering child still needs separate real human approvals.
SWITCHCREW_ORCHESTRATION_JOB_KEY=
# Per-specialist private --capability-config files hold local snapshot paths/jobs.
# ELEVENLABS_API_KEY belongs only in the Voice process environment, never this shared config.

# Opt-in natural incident intake in verified bound Discord channels.
SWITCHCREW_INCIDENT_CHANNEL_IDS=[]
SWITCHCREW_INCIDENT_MAX_EVENTS_PER_MINUTE=10

# Optional guarded merge service. API process only; never inject into workers.
SWITCHCREW_MERGE_ENABLED=false
SWITCHCREW_MERGE_GITHUB_TOKEN=
# Exact GitHub check-run names or commit-status contexts; required when enabled.
SWITCHCREW_MERGE_REQUIRED_CHECKS=["test"]
